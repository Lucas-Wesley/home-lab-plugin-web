{
  "manifest_version": 3,
  "name": "Homelab",
  "version": "1.1.0",
  "description": "Manda o vídeo do YouTube ao Acervo e a página do Mairo Vergara ao Flashcards, com um botão discreto na página.",
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" },
  "action": { "default_title": "Homelab", "default_popup": "popup.html", "default_icon": { "16": "icones/16.png", "32": "icones/32.png" } },
  "background": { "service_worker": "servico.js" },
  "permissions": ["storage"],
  "host_permissions": ["https://192.168.1.20/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://www.mairovergara.com/*", "https://mairovergara.com/*"],
      "js": ["destinos.js", "pagina.js"],
      "run_at": "document_idle"
    }
  ]
}
