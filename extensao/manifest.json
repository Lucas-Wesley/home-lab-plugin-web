{
  "manifest_version": 3,
  "name": "Homelab",
  "version": "1.4.0",
  "description": "Manda vídeos, artigos e qualquer página ao Acervo ou ao Flashcards: pelo popup, pelo botão direito num link ou pelo botão discreto na página.",
  "icons": { "16": "icones/16.png", "32": "icones/32.png", "48": "icones/48.png", "128": "icones/128.png" },
  "action": { "default_title": "Homelab", "default_popup": "popup.html", "default_icon": { "16": "icones/16.png", "32": "icones/32.png" } },
  "background": { "service_worker": "servico.js" },
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["https://192.168.1.20/*", "https://*.internal/*"],
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "exclude_matches": ["https://192.168.1.20/*", "https://*.internal/*"],
      "js": ["destinos.js", "pagina.js"],
      "run_at": "document_idle"
    }
  ]
}
